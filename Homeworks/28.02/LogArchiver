using System;
using System.IO;
using System.IO.Compression;

class Program
{
    static void Main()
    {
        string compressedFile = "logs.gz";
        string rawFile = "logs.txt";
        int iterations = 100_000;

        using (FileStream fs = new FileStream(compressedFile, FileMode.Create)) 
        using (GZipStream gs = new GZipStream(fs, CompressionMode.Compress))  
        using (BufferedStream bs = new BufferedStream(gs))                  
        using (StreamWriter sw = new StreamWriter(bs))                       
        {
            for (int i = 1; i <= iterations; i++)
            {
                sw.WriteLine($"[Log] Message {i} - {DateTime.Now}");         
            }
        }

        // Для сравнения создадим обычный текстовый файл
        File.WriteAllLines(rawFile, GenerateLogs(iterations));

        // 6. Сравнение размеров
        FileInfo gzInfo = new FileInfo(compressedFile);
        FileInfo txtInfo = new FileInfo(rawFile);

        Console.WriteLine($"Размер сжатого файла (.gz): {gzInfo.Length / 1024.0:F2} КБ");
        Console.WriteLine($"Размер обычного файла (.txt): {txtInfo.Length / 1024.0:F2} КБ");
        Console.WriteLine($"Эффективность сжатия: {(double)txtInfo.Length / gzInfo.Length:F1}x");
    }

    static string[] GenerateLogs(int count)
    {
        string[] logs = new string[count];
        for (int i = 0; i < count; i++)
            logs[i] = $"[Log] Message {i + 1} - {DateTime.Now}";
        return logs;
    }
}
       
 
